{
  "name": "atlas-wiki",
  "version": "0.2.0",
  "description": "TypeScript-first, SQLite-first, source-backed, permission-aware knowledge wiki and ledger.",
  "type": "module",
  "license": "MIT",
  "author": "mandarange",
  "homepage": "https://github.com/mandarange/Atlas-WiKi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandarange/Atlas-WiKi.git"
  },
  "bugs": {
    "url": "https://github.com/mandarange/Atlas-WiKi/issues"
  },
  "keywords": [
    "wiki",
    "knowledge-ledger",
    "sqlite",
    "mcp",
    "rag",
    "typescript",
    "audit",
    "acl"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "awiki": "dist/cli/awiki.js",
    "atlas-wiki": "dist/cli/awiki.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/atlas-wiki.d.ts",
      "import": "./dist/sdk/atlas-wiki.js"
    },
    "./cli": {
      "types": "./dist/cli/awiki.d.ts",
      "import": "./dist/cli/awiki.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./mcp/admin": {
      "types": "./dist/mcp/admin.d.ts",
      "import": "./dist/mcp/admin.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./sqlite": {
      "types": "./dist/store/sqlite/index.d.ts",
      "import": "./dist/store/sqlite/index.js"
    },
    "./supabase": {
      "types": "./dist/store/supabase/index.d.ts",
      "import": "./dist/store/supabase/index.js"
    },
    "./structured": {
      "types": "./dist/structured/index.d.ts",
      "import": "./dist/structured/index.js"
    },
    "./extractors": {
      "types": "./dist/extractors/index.d.ts",
      "import": "./dist/extractors/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js"
    },
    "./rag/gemini": {
      "types": "./dist/rag/providers/gemini.d.ts",
      "import": "./dist/rag/providers/gemini.js"
    },
    "./rag/testing": {
      "types": "./dist/rag/providers/testing.d.ts",
      "import": "./dist/rag/providers/testing.js"
    },
    "./release": {
      "types": "./dist/release/manifest.d.ts",
      "import": "./dist/release/manifest.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "!docs/goal",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist coverage .atlas-wiki tmp/wiki tmp/package-smoke tmp/type-consumer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "prepack": "npm run build",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format-check.mjs",
    "test": "vitest run",
    "test:db": "vitest run tests/migrations-hardening.test.ts tests/integration.test.ts",
    "test:migrations": "vitest run tests/migrations-hardening.test.ts",
    "test:integrity": "vitest run tests/migrations-hardening.test.ts tests/integration.test.ts",
    "test:security": "vitest run tests/security.test.ts",
    "test:access": "vitest run tests/security.test.ts",
    "test:context-leakage": "vitest run tests/security.test.ts tests/context-hardening.test.ts",
    "test:mcp": "vitest run tests/mcp-hardening.test.ts",
    "test:mcp:readonly": "vitest run tests/mcp-hardening.test.ts",
    "test:mcp:admin": "vitest run tests/mcp-hardening.test.ts",
    "test:mcp:root-safety": "vitest run tests/mcp-hardening.test.ts",
    "test:audit": "vitest run tests/security.test.ts tests/audit-hardening.test.ts",
    "test:structured": "vitest run tests/structured-ingestion.test.ts",
    "test:rag": "vitest run tests/rag.test.ts",
    "test:cli-setup": "vitest run tests/cli-setup.test.ts",
    "test:store-contract": "vitest run tests/store-contract.test.ts",
    "test:supabase:mock": "vitest run tests/supabase-store.test.ts",
    "test:supabase:local": "node scripts/supabase-local-test.mjs",
    "test:hardening": "vitest run tests/production-hardening-completion.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:types": "npm run build && node scripts/type-consumer-smoke.mjs",
    "schemas:validate": "node scripts/validate-schemas.mjs",
    "hardening:verify": "node scripts/verify-production-hardening.mjs",
    "package:verify": "npm run build && node scripts/package-verify.mjs",
    "packcheck": "npm run package:verify && npm run package:dry-run && npm run package:smoke",
    "package:dry-run": "node scripts/package-dry-run.mjs",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "package:published-smoke": "node scripts/published-package-smoke.mjs",
    "release:published-check": "npm run package:published-smoke",
    "release:next-stable-generate": "npm run build && node scripts/generate-next-stable-release-evidence.mjs",
    "release:next-stable-verify": "npm run release:next-stable-generate && node scripts/verify-next-stable-release.mjs",
    "selftest": "node scripts/selftest.mjs",
    "goal:coverage": "node scripts/generate-task-coverage.mjs",
    "release:check": "npm run typecheck && npm run build && npm run lint && npm run test && npm run test:security && npm run test:context-leakage && npm run test:mcp && npm run test:audit && npm run test:structured && npm run test:rag && npm run test:cli-setup && npm run test:store-contract && npm run test:supabase:mock && npm run test:integration && npm run test:hardening && npm run test:types && npm run schemas:validate && npm run hardening:verify && npm run release:next-stable-verify && npm run package:verify && npm run package:dry-run && npm run package:smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@google/genai": "^2.0.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
